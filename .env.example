# Copy to .env for local development:  cp .env.example .env
# On a deployed Databricks App these come from app.yaml / the bound resources instead.

# Auth — the Databricks CLI profile to use (configured via `databricks auth login`).
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Lakebase (your operational + synced data). Local dev connects by PROJECT + BRANCH; the deployed
# app instead receives LAKEBASE_AUTOSCALING_ENDPOINT from the bound `postgres` resource.
LAKEBASE_AUTOSCALING_PROJECT=lakebase-customer-support
LAKEBASE_AUTOSCALING_BRANCH=production
LAKEBASE_SCHEMA=customer_support
LAKEBASE_SYNCED_SCHEMA=kb_synced
# The pgvector `vector` type + Lakebase Search extensions live in `public`, so this covers KB search.
LAKEBASE_SEARCH_PATH=customer_support, kb_synced, public

# Unity Catalog sources that the synced tables (kb_articles, customer_360) replicate from.
UC_CATALOG=main
UC_SCHEMA=customer_support

# Model serving endpoints.
LLM_ENDPOINT=databricks-claude-sonnet-4-5
DATABRICKS_EMBEDDING_ENDPOINT=databricks-gte-large-en

# Databricks managed session + memory store names (separate namespaces; same name is fine).
# Auto-created by the app on first use.
MANAGED_MEMORY_STORE=support-copilot
MANAGED_SESSION_STORE=support-copilot

# MLflow (traces). Local dev can use a SQLite file; the deployed app uses "databricks".
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
